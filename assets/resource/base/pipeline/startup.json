{
    "Startup_Launch": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 4000,
        "next": [
            "Common_HomeCheck",
            "Common_HomeCheck_Icon",
            "Startup_ClickStart_Direct",
            "Startup_StartApp"
        ]
    },
    "Startup_ClickStart_Direct": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [520, 480, 260, 140],
                "expected": ["开始", "进入"]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 3000,
        "next": [
            "Startup_WaitIntoHome"
        ]
    },
    "Startup_WaitIntoHome": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "rate_limit": 1000,
        "timeout": 180000,
        "next": [
            "Common_HomeCheck",
            "Common_HomeCheck_Icon",
            "[JumpBack]Common_UpdateConfirm",
            "[JumpBack]Common_ReconnectRoom",
            "[JumpBack]Common_NetworkDisconnect",
            "[JumpBack]Startup_ClickStart",
            "[JumpBack]Common_ClickBlankClose",
            "[JumpBack]Common_ClickCancel",
            "[JumpBack]Startup_ClosePopupIcon",
            "[JumpBack]Startup_CloseDailyAttendance",
            "[JumpBack]Startup_CloseGiftPopup",
            "[JumpBack]Startup_CloseAnnouncement",
            "[JumpBack]Common_BattleEndReturn",
            "[JumpBack]Common_SweepEndConfirm",
            "[JumpBack]Common_ClickTopHomeIcon"
        ],
        "on_error": [
            "Common_RestartApp"
        ]
    },
    "Startup_StartApp": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.orlesh.yjzs/com.orlesh.sdkdemo.PrivateActivity"
            }
        },
        "post_delay": 3000,
        "next": [
            "Startup_WaitIntoHome"
        ],
        "on_error": [
            "Startup_WaitIntoHome"
        ]
    },
    "Startup_ClickStart": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [520, 480, 260, 140],
                "expected": ["开始", "进入"]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 3000
    },
    "Startup_ClosePopupIcon": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [1080, 0, 180, 120],
                "template": "startup/close_popup.png",
                "threshold": 0.75
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 800
    },
    "Startup_CloseDailyAttendance": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [450, 95, 380, 55],
                "expected": ["DAILY ATTENDANCE", "ATTENDANCE"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [1116, 95, 20, 20]
            }
        },
        "post_delay": 700
    },
    "Startup_CloseGiftPopup": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [760, 500, 360, 80],
                "expected": ["购买"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [1154, 42, 20, 20]
            }
        },
        "post_delay": 800
    },
    "Startup_CloseAnnouncement": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1040, 15, 220, 90],
                "expected": ["关闭", "×", "X"]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 800
    }
}
