{
    "Startup_Launch": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "Common_HomeCheck",
            "Startup_StartApp"
        ]
    },
    "Startup_StartApp": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.orlesh.yjzs/com.orlesh.sdkdemo.PrivateActivity"
            }
        },
        "post_delay": 3000,
        "timeout": 50000,
        "next": [
            "Common_HomeCheck",
            "[JumpBack]Common_UpdateConfirm",
            "[JumpBack]Common_ReconnectRoom",
            "[JumpBack]Common_NetworkDisconnect",
            "[JumpBack]Startup_ClickStart",
            "[JumpBack]Common_ClickBlankClose",
            "[JumpBack]Common_ClickCancel",
            "[JumpBack]Startup_CloseAnnouncement",
            "[JumpBack]Common_BattleEndReturn",
            "[JumpBack]Common_SweepEndConfirm"
        ],
        "on_error": [
            "Common_RestartApp"
        ]
    },
    "Startup_ClickStart": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [520, 480, 260, 140],
                "expected": ["开始", "进入"]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 3000
    },
    "Startup_CloseAnnouncement": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1040, 15, 220, 90],
                "expected": ["关闭", "×", "X"]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 800
    }
}
