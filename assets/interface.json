{
    "interface_version": 2,
    "name": "MET",
    "label": "MET (Maa Eternal Tree)",
    "title": "MET - 悠久之树助手",
    "icon": "logo.png",
    "version": "0.0.0-dev",
    "github": "https://github.com/Shaw-W/MET",
    "license": "LICENSE",
    "description": "基于 MaaFramework 与 MXU 开发的《悠久之树》自动化助手（纯 Pipeline 架构，仅支持 Windows）。",
    "welcome": [
        "欢迎使用 MET（Maa Eternal Tree）！",
        "当前已支持「启动游戏 / 体力补给 / 行会日常 / 领取奖励（邮件、任务、探求者之书、器灵讨伐书、探求者手记）」，推荐使用「核心日常（推荐）」预设一键运行。",
        "其余扫荡、战斗与活动模块正在按 4.0 界面陆续校准中，欢迎在 GitHub 反馈问题或建议。"
    ],
    "controller": [
        {
            "name": "ADB",
            "label": "ADB 模拟器",
            "description": "通过 ADB 连接安卓模拟器（推荐 1280×720 分辨率）",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "Win32",
            "label": "Win32 桌面端",
            "description": "通过 Win32 API 连接《悠久之树》PC 窗口",
            "type": "Win32",
            "display_short_side": 720,
            "attach_resource_path": [
                "resource/win32"
            ],
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "([Ee]ternal\\s*[Tt]ree|悠久之树)",
                "screencap": "FramePool",
                "mouse": "Seize",
                "keyboard": "Seize"
            }
        }
    ],
    "pretask": [
        {
            "name": "LaunchGamePC",
            "label": "启动 eternaltree.exe",
            "description": "连接窗口前检测 eternaltree.exe 是否已在运行；进程在则直接跳过，未运行则自动启动并等待主窗口就绪",
            "controller": [
                "Win32"
            ],
            "exec": "agent/met-service.exe",
            "args": [
                "--pretask",
                "LaunchGamePC"
            ],
            "option": [
                "PCGamePathMode"
            ]
        }
    ],
    "preset": [
        {
            "name": "DailyCore",
            "label": "核心日常（推荐）",
            "description": "PC 自动拉起 + 启动游戏 + 体力补给 + 行会日常 + 收尾领取奖励",
            "pretask": [
                {
                    "name": "LaunchGamePC"
                }
            ],
            "task": [
                {
                    "name": "Startup"
                },
                {
                    "name": "StaminaSupply"
                },
                {
                    "name": "DailyGuild"
                },
                {
                    "name": "ClaimRewards"
                }
            ]
        }
    ],
    "resource": [
        {
            "name": "Official",
            "label": "官服",
            "description": "《悠久之树》官方服务器资源",
            "path": [
                "resource/base"
            ]
        },
        {
            "name": "Bilibili",
            "label": "B服",
            "description": "《悠久之树》Bilibili 服务器资源（基于官服差异覆盖）",
            "path": [
                "resource/base",
                "resource/bilibili"
            ]
        }
    ],
    "task": [
        {
            "name": "Startup",
            "label": "启动游戏",
            "description": "启动《悠久之树》并自动关闭更新提示、礼包与登录弹窗进入主界面",
            "entry": "Startup_Launch"
        },
        {
            "name": "StaminaSupply",
            "label": "体力补给",
            "description": "前置进入「活动 → 福利放送」连续领取每日物资（12点/18点）与在线奖励",
            "entry": "Daily_StaminaSupply",
            "option": [
                "WelfareClaimSupply",
                "WelfareClaimOnline"
            ]
        },
        {
            "name": "DailyGuild",
            "label": "行会日常",
            "description": "自动完成每日行会签到与捐赠（支持分别开关并设置每日捐赠次数上限）",
            "entry": "Daily_GuildSignIn",
            "option": [
                "GuildSignInSwitch",
                "GuildDonateSwitch"
            ]
        },
        {
            "name": "BattleCoopAuto",
            "label": "联机自动战斗",
            "description": "进入「联机 → 自动战斗」按游戏内已配置计划挂机连战，并自动监测画面卡死强杀重启续刷",
            "entry": "Battle_Coop_Auto_Start",
            "option": [
                "CoopFreezeTimeout",
                "CoopApplySettings"
            ]
        },
        {
            "name": "ClaimRewards",
            "label": "领取奖励",
            "description": "收尾清红点：一键领取邮件、任务（日常/主线/成就）、探求者之书/器灵讨伐书及探求者手记奖励",
            "entry": "Daily_ClaimRewards",
            "option": [
                "ClaimMailSwitch",
                "ClaimTasksSwitch",
                "ClaimSeekerBookSwitch",
                "ClaimHandbookSwitch"
            ]
        }
    ],
    "option": {
        "ClaimMailSwitch": {
            "type": "switch",
            "label": "一键领取邮件",
            "description": "自动打开邮箱并一键收取全部附件",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启"
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Rewards_StepMail": {
                            "next": [
                                "Daily_Rewards_StepTasks"
                            ]
                        }
                    }
                }
            ]
        },
        "ClaimTasksSwitch": {
            "type": "switch",
            "label": "任务领奖",
            "description": "自动打开菜单抽屉进入「任务」，按勾选页签一键领取奖励",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "option": [
                        "TaskClaimDaily",
                        "TaskClaimMain",
                        "TaskClaimAchievement"
                    ]
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Rewards_StepTasks": {
                            "next": [
                                "Daily_Rewards_StepBook"
                            ]
                        }
                    }
                }
            ]
        },
        "ClaimSeekerBookSwitch": {
            "type": "switch",
            "label": "探求者之书 / 器灵讨伐书",
            "description": "依次领取日常任务、本周任务与等级奖励",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "option": [
                        "SeekerBookMain",
                        "SeekerBookSpirit"
                    ]
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Rewards_StepBook": {
                            "next": [
                                "Daily_Rewards_StepHandbook"
                            ]
                        }
                    }
                }
            ]
        },
        "ClaimHandbookSwitch": {
            "type": "switch",
            "label": "探求者手记",
            "description": "自动领取探求者手记的每日奖励与里程碑一键领取",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启"
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Rewards_StepHandbook": {
                            "next": [
                                "Common_BackHome"
                            ]
                        }
                    }
                }
            ]
        },
        "SeekerBookMain": {
            "type": "switch",
            "label": "探求者之书",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启"
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Book_StepMain": {
                            "next": [
                                "Daily_Book_StepSpirit"
                            ]
                        }
                    }
                }
            ]
        },
        "SeekerBookSpirit": {
            "type": "switch",
            "label": "器灵讨伐书",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启"
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Book_StepSpirit": {
                            "next": [
                                "Daily_Rewards_StepHandbook"
                            ]
                        }
                    }
                }
            ]
        },
        "TaskClaimDaily": {
            "type": "switch",
            "label": "日常任务（含每日/每周活跃宝箱）",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启"
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Tasks_StepDaily": {
                            "next": [
                                "Daily_Tasks_StepMain"
                            ]
                        }
                    }
                }
            ]
        },
        "TaskClaimMain": {
            "type": "switch",
            "label": "主线任务",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启"
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Tasks_StepMain": {
                            "next": [
                                "Daily_Tasks_StepAchievement"
                            ]
                        }
                    }
                }
            ]
        },
        "TaskClaimAchievement": {
            "type": "switch",
            "label": "成就任务",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启"
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Tasks_StepAchievement": {
                            "next": [
                                "Daily_Rewards_StepBook"
                            ]
                        }
                    }
                }
            ]
        },
        "WelfareClaimSupply": {
            "type": "switch",
            "label": "领取每日物资（12点/18点）",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "Daily_Welfare_StepSupply": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Welfare_StepSupply": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "WelfareClaimOnline": {
            "type": "switch",
            "label": "领取在线奖励",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "Daily_Welfare_StepOnline": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Welfare_StepOnline": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "StaminaRefill": {
            "type": "select",
            "label": "自动补体",
            "description": "体力不足时是否自动使用药水补充体力",
            "default_case": "Disabled",
            "cases": [
                {
                    "name": "Disabled",
                    "label": "不自动补体",
                    "pipeline_override": {
                        "Battle_Multi_CreateRefill": {
                            "enabled": false
                        },
                        "Battle_Multi_JoinRefill": {
                            "enabled": false
                        },
                        "Battle_GodSleep_DoRefill": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "UsePotion",
                    "label": "使用体力药水补体",
                    "pipeline_override": {
                        "Battle_Multi_CreateRefill": {
                            "enabled": true
                        },
                        "Battle_Multi_JoinRefill": {
                            "enabled": true
                        },
                        "Battle_GodSleep_DoRefill": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "MaterialSweepCount": {
            "type": "select",
            "label": "素材扫荡次数",
            "description": "选择每日素材关卡扫荡 1 次（完成日常）或最大扫荡",
            "default_case": "Once",
            "cases": [
                {
                    "name": "Once",
                    "label": "仅扫荡 1 次",
                    "pipeline_override": {
                        "Daily_Material_RunSweep": {
                            "next": [
                                "Common_Sweep_Open"
                            ]
                        }
                    }
                },
                {
                    "name": "Max",
                    "label": "最大次数扫荡",
                    "pipeline_override": {
                        "Daily_Material_RunSweep": {
                            "next": [
                                "Common_Sweep_OpenMax"
                            ]
                        }
                    }
                }
            ]
        },
        "GodSleepBoss": {
            "type": "select",
            "label": "神眠之地首领",
            "description": "选择神眠之地目标首领",
            "default_case": "Any",
            "cases": [
                {
                    "name": "Any",
                    "label": "自动匹配（新生 / 罪人）",
                    "pipeline_override": {
                        "Battle_GodSleep_SelectBoss": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [
                                        21,
                                        132,
                                        1213,
                                        495
                                    ],
                                    "expected": [
                                        "新生",
                                        "罪人"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Reborn",
                    "label": "懊悔的新生",
                    "pipeline_override": {
                        "Battle_GodSleep_SelectBoss": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [
                                        21,
                                        132,
                                        1213,
                                        495
                                    ],
                                    "expected": [
                                        "新生"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Sinner",
                    "label": "褪色的罪人",
                    "pipeline_override": {
                        "Battle_GodSleep_SelectBoss": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [
                                        21,
                                        132,
                                        1213,
                                        495
                                    ],
                                    "expected": [
                                        "罪人"
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        },
        "MainStoryDifficulty": {
            "type": "select",
            "label": "主线扫荡难度",
            "description": "选择要扫荡的主线关卡难度",
            "default_case": "Hard",
            "cases": [
                {
                    "name": "Hard",
                    "label": "仅困难",
                    "pipeline_override": {
                        "Daily_Story_SelectDifficulty": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [
                                        20,
                                        620,
                                        260,
                                        55
                                    ],
                                    "expected": [
                                        "困难"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "VeryHard",
                    "label": "仅极难",
                    "pipeline_override": {
                        "Daily_Story_SelectDifficulty": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [
                                        20,
                                        620,
                                        260,
                                        55
                                    ],
                                    "expected": [
                                        "极难"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Both",
                    "label": "困难 + 极难",
                    "pipeline_override": {
                        "Daily_Story_SelectTab": {
                            "next": [
                                "Daily_Story_SelectPart1",
                                "Daily_Story_BothSweep"
                            ]
                        },
                        "Daily_Story_SelectPart1": {
                            "next": [
                                "Daily_Story_BothSweep"
                            ]
                        }
                    }
                }
            ]
        },
        "MultiBattleMode": {
            "type": "select",
            "label": "多人战斗模式",
            "description": "选择自动建房或快速加入蹭车模式",
            "default_case": "CreateRoom",
            "cases": [
                {
                    "name": "CreateRoom",
                    "label": "自动建房",
                    "pipeline_override": {
                        "Battle_Multi_ModeDispatch": {
                            "next": [
                                "Battle_Multi_CreateNavigate",
                                "Battle_Multi_CreateRoom"
                            ]
                        }
                    }
                },
                {
                    "name": "JoinRoom",
                    "label": "蹭车模式",
                    "pipeline_override": {
                        "Battle_Multi_ModeDispatch": {
                            "next": [
                                "Battle_Multi_JoinNavigate",
                                "Battle_Multi_JoinRoom"
                            ]
                        }
                    }
                }
            ]
        },
        "PeachGardenAttribute": {
            "type": "select",
            "label": "神狱桃园乡属性",
            "description": "选择神狱桃园乡目标属性区域",
            "default_case": "Fire",
            "cases": [
                {
                    "name": "Fire",
                    "label": "朱雀（火）",
                    "pipeline_override": {
                        "Activity_PeachGarden_SelectAttribute": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [
                                        283,
                                        480,
                                        972,
                                        151
                                    ],
                                    "expected": [
                                        "朱雀"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Water",
                    "label": "玄武（水）",
                    "pipeline_override": {
                        "Activity_PeachGarden_SelectAttribute": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [
                                        283,
                                        480,
                                        972,
                                        151
                                    ],
                                    "expected": [
                                        "玄武"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Wind",
                    "label": "青龙（风）",
                    "pipeline_override": {
                        "Activity_PeachGarden_SelectAttribute": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [
                                        283,
                                        480,
                                        972,
                                        151
                                    ],
                                    "expected": [
                                        "青龙"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Earth",
                    "label": "白虎（土）",
                    "pipeline_override": {
                        "Activity_PeachGarden_SelectAttribute": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [
                                        283,
                                        480,
                                        972,
                                        151
                                    ],
                                    "expected": [
                                        "白虎"
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        },
        "PCGamePathMode": {
            "type": "select",
            "label": "游戏路径",
            "description": "默认自动探测常见安装目录；若未找到或有多版本，请切换为「手动填写」",
            "default_case": "Auto",
            "cases": [
                {
                    "name": "Auto",
                    "label": "自动判断"
                },
                {
                    "name": "Manual",
                    "label": "手动填写",
                    "option": [
                        "PCGameExePath"
                    ]
                }
            ]
        },
        "PCGameExePath": {
            "type": "input",
            "label": "主程序路径",
            "description": "选择游戏目录下的 eternaltree.exe",
            "inputs": [
                {
                    "name": "GameExe",
                    "label": "eternaltree.exe 路径",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^\"?.+[\\\\/][Ee]ternaltree\\.exe\"?$",
                    "pattern_msg": "请填写 eternaltree.exe 的完整路径，例如 C:\\TapTap\\PC Games\\176733\\...\\eternaltree.exe",
                    "input_type": "file"
                }
            ]
        },
        "GuildSignInSwitch": {
            "type": "switch",
            "label": "行会签到",
            "description": "进入行会后执行每日签到",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启"
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Guild_StepSignIn": {
                            "next": [
                                "Daily_Guild_StepDonate"
                            ]
                        }
                    }
                }
            ]
        },
        "GuildDonateSwitch": {
            "type": "switch",
            "label": "行会捐赠",
            "description": "进入行会后执行每日物资捐赠",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "option": [
                        "GuildDonateCount"
                    ]
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Daily_Guild_StepDonate": {
                            "next": [
                                "Common_BackHome"
                            ]
                        }
                    }
                }
            ]
        },
        "CoopFreezeTimeout": {
            "type": "select",
            "label": "卡死重启判定时间",
            "description": "官方自动战斗期间画面完全静止超过该时长（且非正常结束）时，自动强杀重启客户端并续刷",
            "default_case": "Min5",
            "cases": [
                {
                    "name": "Min2",
                    "label": "2 分钟",
                    "pipeline_override": {
                        "Battle_Coop_Auto_Monitor": {
                            "pre_wait_freezes": {
                                "time": 120000,
                                "target": [
                                    0,
                                    0,
                                    1280,
                                    720
                                ],
                                "timeout": 43200000,
                                "threshold": 0.999,
                                "rate_limit": 5000
                            }
                        }
                    }
                },
                {
                    "name": "Min3",
                    "label": "3 分钟",
                    "pipeline_override": {
