{
    "interface_version": 2,
    "name": "MET",
    "label": "MET (Maa Eternal Tree)",
    "title": "MET - 悠久之树助手",
    "icon": "logo.png",
    "version": "0.0.0-dev",
    "github": "https://github.com/Shaw-W/MET",
    "license": "MIT",
    "description": "基于 MaaFramework 与 MXU 开发的《悠久之树》自动化助手（纯 Pipeline 架构，仅支持 Windows）。",
    "welcome": [
        "欢迎使用 MET（Maa Eternal Tree）！",
        "当前处于脚手架初始化阶段，各任务节点正在按开发计划逐步完善中。"
    ],
    "controller": [
        {
            "name": "ADB",
            "label": "ADB 模拟器",
            "description": "通过 ADB 连接安卓模拟器（推荐 1280×720 分辨率）",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "Win32",
            "label": "Win32 桌面端",
            "description": "通过 Win32 API 连接《悠久之树》PC 窗口",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "([Ee]ternal\\s*[Tt]ree|悠久之树)"
            }
        }
    ],
    "resource": [
        {
            "name": "Official",
            "label": "官服",
            "description": "《悠久之树》官方服务器资源",
            "path": [
                "{PROJECT_DIR}/resource/base"
            ]
        },
        {
            "name": "Bilibili",
            "label": "B服",
            "description": "《悠久之树》Bilibili 服务器资源（基于官服差异覆盖）",
            "path": [
                "{PROJECT_DIR}/resource/base",
                "{PROJECT_DIR}/resource/bilibili"
            ]
        }
    ],
    "task": [
        {
            "name": "Startup",
            "label": "启动游戏",
            "description": "启动《悠久之树》并自动关闭登录弹窗进入主界面",
            "entry": "Startup_Launch"
        },
        {
            "name": "DailySupply",
            "label": "每日物资",
            "description": "自动领取每日物资奖励",
            "entry": "Daily_ClaimSupply"
        },
        {
            "name": "DailyGuild",
            "label": "行会签到与捐赠",
            "description": "自动完成每日行会签到与捐赠",
            "entry": "Daily_GuildSignIn"
        },
        {
            "name": "DailyMaterial",
            "label": "素材关卡扫荡",
            "description": "自动扫荡素材关卡（支持扫荡 1 次或最大扫荡）",
            "entry": "Daily_MaterialSweep",
            "option": [
                "MaterialSweepCount"
            ]
        },
        {
            "name": "DailyMainStory",
            "label": "主线困难与极难扫荡",
            "description": "自动扫荡困难与极难主线关卡",
            "entry": "Daily_MainStorySweep",
            "option": [
                "MainStoryDifficulty"
            ]
        },
        {
            "name": "DailyQuests",
            "label": "每日任务领奖",
            "description": "自动进入探求手记一键领取每日任务奖励",
            "entry": "Daily_ClaimQuests"
        },
        {
            "name": "DailyMail",
            "label": "一键领取邮件",
            "description": "自动打开邮箱并一键收取所有附件",
            "entry": "Daily_ClaimMail"
        },
        {
            "name": "BattleMulti",
            "label": "多人战斗",
            "description": "自动重复刷多人战斗关卡（支持自动建房 / 蹭车模式与自动补体）",
            "entry": "Battle_Multi_Start",
            "option": [
                "MultiBattleMode",
                "StaminaRefill"
            ]
        },
        {
            "name": "BattleGodSleep",
            "label": "神眠之地",
            "description": "自动重复刷神眠之地",
            "entry": "Battle_GodSleep_Start",
            "option": [
                "GodSleepBoss",
                "StaminaRefill"
            ]
        },
        {
            "name": "BattleKinnara",
            "label": "紧那罗击退战（暂缓实现）",
            "description": "当前版本暂缓实现，后续按需补充",
            "entry": "Battle_Kinnara_Start"
        },
        {
            "name": "ActivityPeachGarden",
            "label": "神狱桃园乡",
            "description": "自动扫荡并领取神狱桃园乡奖励",
            "entry": "Activity_PeachGarden_Claim",
            "option": [
                "PeachGardenAttribute"
            ]
        },
        {
            "name": "ActivityExplore",
            "label": "探索活动领奖",
            "description": "自动领取探索活动奖励",
            "entry": "Activity_Explore_Claim"
        }
    ],
    "option": {
        "StaminaRefill": {
            "type": "select",
            "label": "自动补体",
            "description": "体力不足时是否自动使用药水补充体力",
            "default_case": "Disabled",
            "cases": [
                {
                    "name": "Disabled",
                    "label": "不自动补体",
                    "pipeline_override": {
                        "Battle_Multi_CreateRefill": {
                            "enabled": false
                        },
                        "Battle_Multi_JoinRefill": {
                            "enabled": false
                        },
                        "Battle_GodSleep_DoRefill": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "UsePotion",
                    "label": "使用体力药水补体",
                    "pipeline_override": {
                        "Battle_Multi_CreateRefill": {
                            "enabled": true
                        },
                        "Battle_Multi_JoinRefill": {
                            "enabled": true
                        },
                        "Battle_GodSleep_DoRefill": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "MaterialSweepCount": {
            "type": "select",
            "label": "素材扫荡次数",
            "description": "选择每日素材关卡扫荡 1 次（完成日常）或最大扫荡",
            "default_case": "Once",
            "cases": [
                {
                    "name": "Once",
                    "label": "仅扫荡 1 次",
                    "pipeline_override": {
                        "Daily_Material_RunSweep": {
                            "next": [
                                "Common_Sweep_Open"
                            ]
                        }
                    }
                },
                {
                    "name": "Max",
                    "label": "最大次数扫荡",
                    "pipeline_override": {
                        "Daily_Material_RunSweep": {
                            "next": [
                                "Common_Sweep_OpenMax"
                            ]
                        }
                    }
                }
            ]
        },
        "GodSleepBoss": {
            "type": "select",
            "label": "神眠之地首领",
            "description": "选择神眠之地目标首领",
            "default_case": "Any",
            "cases": [
                {
                    "name": "Any",
                    "label": "自动匹配（新生 / 罪人）",
                    "pipeline_override": {
                        "Battle_GodSleep_SelectBoss": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [21, 132, 1213, 495],
                                    "expected": ["新生", "罪人"]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Reborn",
                    "label": "懊悔的新生",
                    "pipeline_override": {
                        "Battle_GodSleep_SelectBoss": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [21, 132, 1213, 495],
                                    "expected": ["新生"]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Sinner",
                    "label": "褪色的罪人",
                    "pipeline_override": {
                        "Battle_GodSleep_SelectBoss": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [21, 132, 1213, 495],
                                    "expected": ["罪人"]
                                }
                            }
                        }
                    }
                }
            ]
        },
        "MainStoryDifficulty": {
            "type": "select",
            "label": "主线扫荡难度",
            "description": "选择要扫荡的主线关卡难度",
            "default_case": "Hard",
            "cases": [
                {
                    "name": "Hard",
                    "label": "仅困难",
                    "pipeline_override": {
                        "Daily_Story_SelectDifficulty": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [20, 620, 260, 55],
                                    "expected": ["困难"]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "VeryHard",
                    "label": "仅极难",
                    "pipeline_override": {
                        "Daily_Story_SelectDifficulty": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [20, 620, 260, 55],
                                    "expected": ["极难"]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Both",
                    "label": "困难 + 极难",
                    "pipeline_override": {
                        "Daily_Story_SelectTab": {
                            "next": [
                                "Daily_Story_SelectPart1",
                                "Daily_Story_BothSweep"
                            ]
                        },
                        "Daily_Story_SelectPart1": {
                            "next": [
                                "Daily_Story_BothSweep"
                            ]
                        }
                    }
                }
            ]
        },
        "MultiBattleMode": {
            "type": "select",
            "label": "多人战斗模式",
            "description": "选择自动建房或快速加入蹭车模式",
            "default_case": "CreateRoom",
            "cases": [
                {
                    "name": "CreateRoom",
                    "label": "自动建房",
                    "pipeline_override": {
                        "Battle_Multi_ModeDispatch": {
                            "next": [
                                "Battle_Multi_CreateNavigate",
                                "Battle_Multi_CreateRoom"
                            ]
                        }
                    }
                },
                {
                    "name": "JoinRoom",
                    "label": "蹭车模式",
                    "pipeline_override": {
                        "Battle_Multi_ModeDispatch": {
                            "next": [
                                "Battle_Multi_JoinNavigate",
                                "Battle_Multi_JoinRoom"
                            ]
                        }
                    }
                }
            ]
        },
        "PeachGardenAttribute": {
            "type": "select",
            "label": "神狱桃园乡属性",
            "description": "选择神狱桃园乡目标属性区域",
            "default_case": "Fire",
            "cases": [
                {
                    "name": "Fire",
                    "label": "朱雀（火）",
                    "pipeline_override": {
                        "Activity_PeachGarden_SelectAttribute": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [283, 480, 972, 151],
                                    "expected": ["朱雀"]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Water",
                    "label": "玄武（水）",
                    "pipeline_override": {
                        "Activity_PeachGarden_SelectAttribute": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [283, 480, 972, 151],
                                    "expected": ["玄武"]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Wind",
                    "label": "青龙（风）",
                    "pipeline_override": {
                        "Activity_PeachGarden_SelectAttribute": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [283, 480, 972, 151],
                                    "expected": ["青龙"]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Earth",
                    "label": "白虎（土）",
                    "pipeline_override": {
                        "Activity_PeachGarden_SelectAttribute": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [283, 480, 972, 151],
                                    "expected": ["白虎"]
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
